{
  "name": "pi-agent-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "本机 Agent 工作台：对话、工具执行、知识沉淀、界面状态全部落在可恢复的本地存储里",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter @pi/desktop dev",
    "start": "pnpm --filter @pi/desktop start",
    "build": "pnpm --filter @pi/desktop build",
    "package": "pnpm --filter @pi/desktop package",
    "package:dir": "pnpm --filter @pi/desktop package:dir",
    "gate": "pnpm --filter @pi/desktop gate",
    "cli": "tsx --env-file-if-exists=.env apps/cli/src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/desktop/tsconfig.json",
    "lint": "eslint .",
    "smoke": "node -e \"process.stdout.write('/list\\n/new\\n/list\\n/quit\\n')\" | tsx --env-file-if-exists=.env apps/cli/src/main.ts --memory",
    "p0:subapps": "tsx packages/core/src/dev/subapp-p0.ts",
    "p0:subapps:package": "pnpm package:dir && tsx apps/desktop/build/run-subapp-p0-package.ts",
    "m1:subapps:foundation": "tsx apps/desktop/build/subapp-m1-1-foundation.ts",
    "m1:subapps:candidate": "tsx apps/desktop/build/subapp-m1-2-candidate.ts",
    "m1:subapps:installer": "tsx apps/desktop/build/subapp-m1-3-installer.ts",
    "m1:subapps:service": "tsx apps/desktop/build/subapp-m1-3-service.ts"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
