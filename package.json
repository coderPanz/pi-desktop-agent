{
  "name": "pi-agent-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "本机 Agent 工作台：对话、工具执行、知识沉淀、界面状态全部落在可恢复的本地存储里",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter @pi/desktop dev",
    "start": "pnpm --filter @pi/desktop start",
    "build": "pnpm --filter @pi/desktop build",
    "package": "pnpm --filter @pi/desktop package",
    "gate": "pnpm --filter @pi/desktop gate",
    "cli": "tsx --env-file-if-exists=.env apps/cli/src/main.ts",
    "test": "node --import tsx --test \"packages/core/src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/desktop/tsconfig.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
